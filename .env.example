# ForenX Headless Forensic Engine
# Copy to .env for local integrations. Never commit the populated file.
NODE_ENV=development

# Hetzner S3 Object Storage (server-side only; never expose via VITE_)
S3_ENDPOINT=""
S3_REGION="hel1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true

# Supabase service integration
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mistral AI (server-side only)
MISTRAL_API_KEY=""
MISTRAL_API_KEY_ANALYSIS=""
MISTRAL_API_KEY_CHAT=""
MISTRAL_MODEL="mistral-large-latest"

# WhoIsWho SK / RPO registry connector
WHOISWHO_API_URL=""
WHOISWHO_API_KEY=""
WHOISWHO_ENABLED=false

# Optional forensic workers and registry fallbacks
FORENX_AI_WORKER_URL=""
FORENX_AI_WORKER_KEY=""
ICO_ATLAS_API_URL=""
ICO_ATLAS_API_KEY=""
