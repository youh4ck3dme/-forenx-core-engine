{
  "name": "forenx-core-engine",
  "private": "true",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5656",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "start": "node .output/server/index.mjs",
    "preview": "node .output/server/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/lib/__tests__/",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:security": "vitest run src/lib/__tests__/secrets-boundary.test.ts src/lib/__tests__/webhook-security.test.ts src/lib/__tests__/privacy-redact.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test:e2e && npm run test && npm run test:security",
    "test:parity": "bun run scripts/qa/feature-parity-report.ts",
    "test:regression": "vitest run regression autopilot-meta save-case-dossier export-pdf export-court-dossier golden-demo-case e2e-forensic-flow large-upload-e2e s3-storage ocr-fallback forensic-dossier-schema pwa-assets llm-failover mistral-key-purpose mistral-api secrets-boundary forensic-integrity data-relational-integrity whoiswho",
    "test:whoiswho": "vitest run whoiswho",
    "test:e2e:mistral": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test e2e/mistral-live.spec.ts --project=chromium --workers=1",
    "test:integrity": "npm run test:integrity:crypto && npm run test:integrity:data && npm run test:integrity:privacy",
    "test:integrity:crypto": "vitest run src/lib/__tests__/forensic-integrity.test.ts src/lib/__tests__/ledger.test.ts src/lib/__tests__/pdf-provenance-regression.test.ts",
    "test:integrity:data": "vitest run src/lib/__tests__/data-relational-integrity.test.ts src/lib/__tests__/forensic-dossier-schema.test.ts src/lib/__tests__/case-mapper.test.ts src/lib/__tests__/case-graph-apply.test.ts src/lib/__tests__/source-ref.test.ts",
    "test:integrity:privacy": "vitest run src/lib/__tests__/secrets-boundary.test.ts src/lib/__tests__/privacy-redact.test.ts src/lib/__tests__/webhook-security.test.ts src/lib/__tests__/ai-consent.test.ts"
  },
